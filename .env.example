# 青龙、Docker Compose 或本地包装脚本的变量示例。请勿填写真实凭据后提交到仓库。
MAOGUAI_ACCOUNT=
MAOGUAI_PASSWORD=
# MAOGUAI_SESSION_FILE=data/session.cookies

# 以下为可选配置
# MAOGUAI_BASE_URL=https://2550505.com
# 仅在可信 HTTPS 测试环境中使用自定义接口地址时设置为 true。
# MAOGUAI_ALLOW_CUSTOM_BASE_URL=false
# MAOGUAI_CLIENT_VERSION=0c1c05
# MAOGUAI_TIMEOUT=30
# MAOGUAI_RETRIES=2 # 允许范围为 0 到 5

# Docker Compose 挂载本地 data/ 时，使用宿主机 UID/GID，避免容器以 root 写入文件。
# MAOGUAI_UID=1000
# MAOGUAI_GID=1000
